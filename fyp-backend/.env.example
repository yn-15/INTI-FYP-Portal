# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Local: postgresql://USER:PASSWORD@localhost:5432/fyp_db
# Railway: copy from your Railway project dashboard
DATABASE_URL="postgresql://postgres:password@localhost:5432/fyp_db"

# JWT secret — use a long random string in production
JWT_SECRET="change-this-to-a-long-random-secret-string"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Server port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ── Sprint 4 additions ────────────────────────────────────────────────────────

# Resend email API key (get from https://resend.com)
# Required for: registration approval/rejection emails, proposal returned emails, team lock emails
RESEND_API_KEY="re_your_api_key_here"

# Email sender address (must be verified in your Resend account)
EMAIL_FROM="FYP Portal <noreply@yourdomain.com>"

# Direct DB URL (same as DATABASE_URL for Railway; needed for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/fyp_db"
