# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Local: postgresql://USER:PASSWORD@localhost:5432/fyp_db
# Railway: copy from your Railway project dashboard
DATABASE_URL="postgresql://postgres:password@localhost:5432/fyp_db"

# JWT secret — use a long random string in production
JWT_SECRET="change-this-to-a-long-random-secret-string"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Server port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
